* NMCNR Amplifier Testbench (Nested Miller Compensation with Nulling Resistor)
.lib ${SKY130_PDK} tt

.subckt NMCNR GNDA VDDA VINN VINP VOUT
* PMOS BIAS CURRENT MIRROR
xm0 VBIAS VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm1 VB4 VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm2 DM_1 VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm3 VB3 VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm4 TAIL VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=28
xm5 VOUTN VOUTN VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm6 V1OUT VOUTN VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm7 V2OUT VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=7
xm11 VOUT VBIAS VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=9.0 m=70

* FIRST STAGE - PMOS Differential Pair with NMOS Folded Cascode
xm8 DM_N VINN TAIL TAIL sky130_fd_pr__pfet_01v8 l=3.0 w=12.0 m=24
xm9 DM_P VINP TAIL TAIL sky130_fd_pr__pfet_01v8 l=3.0 w=12.0 m=24
xm19 DM_N VB4 GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=400
xm20 DM_P VB4 GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=400
xm15 VOUTN VB3 DM_N GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=200
xm16 V1OUT VB3 DM_P GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=200

* NMOS BIAS GENERATION
xm14 VB3 VB3 GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=400
xm17 NET54 VB4 GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=1600
xm12 VB4 VB3 NET54 GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=1600
xm18 NET56 VB4 GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=1600
xm13 DM_1 VB3 NET56 GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=1600

* SECOND STAGE
xm10 V2IN V1OUT VDDA VDDA sky130_fd_pr__pfet_01v8 l=3.0 w=7.0 m=18
xm21 V2IN V2IN GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=4.0 m=7
xm22 V2OUT V2IN GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=4.0 m=7

* OUTPUT STAGE
xm23 VOUT V2OUT GNDA GNDA sky130_fd_pr__nfet_01v8 l=3.0 w=5.0 m=14

* COMPENSATION (Nested Miller with Nulling Resistor)
C0 V1OUT NR 4.8e-12
C1 NR V2OUT 5.5e-12
R0 NR VOUT 9.4e3

* BIAS CURRENT SOURCE
I0 VBIAS GNDA 19e-6

.ends NMCNR


VDD VDD 0 DC 1.8
VSS VSS 0 DC 0
VINP VINP 0 DC 0.9 AC 0.5
VINN VINN 0 DC 0.9 AC -0.5

XDUT VSS VDD VINN VINP VOUT NMCNR

CLOAD VOUT 0 15e-9
RLOAD VOUT 0 25e3

.control
op
let vdd_current = abs(i(VDD))
let power_dc = vdd_current * 1.8
print power_dc

ac dec 100 1 10g
let gain_db = vdb(VOUT)
let dc_gain_db = gain_db[0]
print dc_gain_db

if dc_gain_db > 0
  meas ac ugbw WHEN gain_db=0 CROSS=1
end
quit
.endc
.end