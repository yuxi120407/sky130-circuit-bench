RL1 GND N_RL1 10k
RL2 GND N_RL2 10k
RL3 GND N_RL3 10k
RL4 GND N_RL4 10k
RS1 N_Q6E N_M5D 10k
RS2 N_Q5E N_M7D 10k
RS3 X2_B N_M13D 10k
RS4 X2 N_M15D 10k
RB N_RB VEE 10k
RB1 N_RB1 VEE 10k
RB2 N_RB2 VEE 10k
RB3 N_RB3 VEE 10k
RB4 N_RB4 VEE 10k
RB5 N_RB5 VEE 10k
RB6 N_RB6 VEE 10k
RB7 N_RB7 VEE 10k
RB8 N_RB8 VEE 10k
CC1 N_RL3 X2_B 1p
CC2 N_RL4 X2 1p
I0 VBIAS VG2 1u
XMA VG2 VG2 VG1 VEE sky130_fd_pr__nfet_01v8 l=0.5 w=5
XMB VG1 VG1 N_RB VEE sky130_fd_pr__nfet_01v8 l=0.5 w=5
XM1 N_Q1E VG2 N_M1S VEE sky130_fd_pr__nfet_01v8 l=0.5 w=5
XM2 N_M1S VG1 N_RB1 VEE sky130_fd_pr__nfet_01v8 l=0.5 w=5
XM3 N_Q3E VG2 N_M3S VEE sky130_fd_pr__nfet_01v8 l=0.5 w=5
