.lib ${SKY130_PDK} tt

VDD VDD 0 1.8
vp Vin 0 PULSE(500m 600m 500n 100p 100p 100n 2u) AC 1
xm28 N001 N001 N004 VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm1 N010 Vbiasn 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
