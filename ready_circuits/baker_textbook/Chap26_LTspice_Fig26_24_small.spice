xm18 ncl Vp N007 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm19 N005 Vp N008 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm20 N006 Vm N008 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm21 vom vodp VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
