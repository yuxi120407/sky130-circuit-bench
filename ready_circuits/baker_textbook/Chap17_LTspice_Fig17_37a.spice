.lib ${SKY130_PDK} tt

VDD VDD 0 1.8
xm3 VDD N005 VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.5
Vphi1 Phi1 0 PULSE(0 1.8 1n 10p 10p 4n 10n)
