xm5 N006 phi2 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm7 vbuck vbucki VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.5
Vr Vr 0 650m
Vi Vi 0 640m
xm1 N005 phi2 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm2 N004 phi1 N006 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm4 N003 phi1 N005 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm6 N002 VDD N004 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm8 N001 Q N003 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm9 vbuck Vi N002 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm10 vbucki Vr N001 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm11 VDD N006 VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.5
xm12 vbucki vbucki VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.5
xm13 0 vbuck 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.5
xm14 0 vbucki 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.5
xm15 n1 vbuck VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm16 n2 vbucki VDD VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm17 n3 Out n1 VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm18 n4 Outi n2 VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm19 Outi phi2 n3 VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm20 Out phi2 n4 VDD sky130_fd_pr__pfet_01v8 w=1.47 l=0.15
xm21 Out Outi 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm22 Outi Out 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm23 Outi phi2 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
xm24 Out phi2 0 0 sky130_fd_pr__nfet_01v8 w=1.47 l=0.15
X_U1 Out Qi Q VDD 0 NOR_2
X_U2 Q Outi Qi VDD 0 NOR_2
.subckt NOR_2 A B Out VDD GND
  xm3 out B N001 VDD sky130_fd_pr__pfet_01v8 w=1 l=0.15
  xm8 N001 A VDD VDD sky130_fd_pr__pfet_01v8 w=1 l=0.15
  xm11 out B GND 0 sky130_fd_pr__nfet_01v8 w=0.5 l=0.15
  xm12 out A 0 0 sky130_fd_pr__nfet_01v8 w=0.5 l=0.15
.ends NOR_2


.control
tran 1p 100n

let power = v(VDD) * abs(i(VDD))
let avg_power = mean(power)
print avg_power

meas tran vout_max MAX v(out)
meas tran vout_min MIN v(out)
let vout_swing = vout_max - vout_min
print vout_swing

meas tran rise_time TRIG v(out) VAL='0.1*vout_max' RISE=1 TARG v(out) VAL='0.9*vout_max' RISE=1
meas tran fall_time TRIG v(out) VAL='0.9*vout_max' FALL=1 TARG v(out) VAL='0.1*vout_max' FALL=1
print rise_time fall_time

quit
.endc

.end
